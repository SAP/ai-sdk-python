FROM dockerio.int.repositories.cloud.sap/python:3.14-slim
ARG ARTIFACTORY=https://int.repositories.cloud.sap/artifactory/api/pypi/build-snapshots-pypi/simple

COPY pyproject.toml version.txt ./
RUN mkdir -p gen_ai_hub && touch gen_ai_hub/__init__.py

RUN apt-get update
RUN apt install make -y
RUN apt install libgeos++-dev -y
RUN apt install gcc -y

RUN pip3 install --upgrade pip
RUN pip3 install --trusted-host int.repositories.cloud.sap --trusted-host github.wdf.sap.corp --index-url $ARTIFACTORY ".[all,dev]"

RUN groupadd -g 999 mlapi && \
    useradd --create-home --home-dir /home/mlapi --system --uid 1000 --gid mlapi mlapi
COPY . /app
RUN chown -R mlapi:mlapi /app
WORKDIR /app
