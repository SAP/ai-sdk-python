FROM dockerio.int.repositories.cloud.sap/python:3.14-slim
ARG ARTIFACTORY=https://int.repositories.cloud.sap/artifactory/api/pypi/build-snapshots-pypi/simple

COPY requirements-test.txt ./requirements-test.txt
COPY requirements.txt ./requirements.txt

RUN apt-get update
RUN apt install make -y
RUN apt install libgeos++-dev -y

RUN pip3 install --upgrade pip
RUN pip3 install --trusted-host int.repositories.cloud.sap --trusted-host github.wdf.sap.corp --index-url $ARTIFACTORY -r requirements.txt
RUN pip3 install -I --index-url $ARTIFACTORY -r requirements-test.txt